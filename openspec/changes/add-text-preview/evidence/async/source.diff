+enum { PreviewIdle, PreviewLoading, PreviewReady, PreviewEmpty,
+       PreviewUnavailable, PreviewTimeout, PreviewTruncated };
+static struct {
+	struct item *item;
+	unsigned long generation, running;
+	pid_t pid, pgid;
+	int input, output, state;
